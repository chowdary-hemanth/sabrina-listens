# Application Environment
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./sabrina_listens.db

# Optional Spotify API Credentials (public metadata works without these)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Storage Paths
OUTPUT_DIRECTORY=~/Downloads/SabrinaListens
TEMP_DIRECTORY=./temp_downloads

# Limits & Concurrency
MAX_CONCURRENT_DOWNLOADS=3
MAX_FILE_SIZE_MB=500

# FFmpeg Executable Path (leave blank for auto-detection in PATH / Stremio / imageio)
FFMPEG_PATH=

# Logging
LOG_LEVEL=INFO
